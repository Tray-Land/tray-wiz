<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TrayWiz.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:TrayWiz"
    xmlns:controls="using:TrayWiz.Controls"
    xmlns:models="using:TrayWiz.Models"
    Background="Transparent"
    IsTabStop="True"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!--  Three 120 px tiles with 8 px between them.  -->
        <ItemsPanelTemplate x:Key="TilePanelTemplate">
            <VariableSizedWrapGrid
                ItemWidth="128"
                MaximumRowsOrColumns="3"
                Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!--
            A bulb: the main area toggles power, the slider sets brightness, the chevron opens its detail view.
            Drag a tile onto a group to move it there, or anywhere else to take it out of its group.
        -->
        <DataTemplate x:Key="BulbTileTemplate" x:DataType="models:Bulb">
            <controls:RichSplitButton
                Margin="4"
                Brightness="{x:Bind Brightness, Mode=OneWay}"
                BrightnessChanged="TileBrightness_Changed"
                Click="TilePower_Click"
                ContextRequested="Tile_ContextRequested"
                Description="{x:Bind Subtitle, Mode=OneWay}"
                DragStarting="Tile_DragStarting"
                DropCompleted="Tile_DropCompleted"
                Glyph="&#xE82F;"
                IsBrightnessVisible="True"
                IsOn="{x:Bind IsOn, Mode=OneWay}"
                IsToggle="True"
                Loaded="Tile_Loaded"
                Opacity="{x:Bind local:MainPage.TileOpacity(IsReachable), Mode=OneWay}"
                SecondaryClick="TileDetails_Click"
                Status="{x:Bind local:MainPage.TileStatus(IsOn, Brightness, IsReachable), Mode=OneWay}"
                TintColor="{x:Bind SwatchColor, Mode=OneWay}"
                Title="{x:Bind DisplayName, Mode=OneWay}" />
        </DataTemplate>

        <!--  A custom action: the main area applies its saved settings to its lights, the chevron edits it.  -->
        <DataTemplate x:Key="ActionTileTemplate" x:DataType="models:LightAction">
            <controls:RichSplitButton
                Margin="4"
                Click="ActionTile_Click"
                ContextRequested="Tile_ContextRequested"
                Description="{x:Bind Name, Mode=OneWay}"
                DragStarting="Tile_DragStarting"
                DropCompleted="Tile_DropCompleted"
                Glyph="{x:Bind Glyph, Mode=OneWay}"
                Loaded="Tile_Loaded"
                SecondaryClick="ActionEdit_Click"
                Title="{x:Bind Name, Mode=OneWay}" />
        </DataTemplate>

        <controls:TileTemplateSelector
            x:Key="TileTemplateSelector"
            ActionTemplate="{StaticResource ActionTileTemplate}"
            BulbTemplate="{StaticResource BulbTileTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid x:Name="HomeView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Padding="16,12,8,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE82F;" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="TrayWiz" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        AutomationProperties.Name="All lights on"
                        Command="{x:Bind ViewModel.AllOnCommand}"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTipService.ToolTip="All on">
                        <FontIcon FontSize="16" Glyph="&#xE706;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="All lights off"
                        Command="{x:Bind ViewModel.AllOffCommand}"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTipService.ToolTip="All off">
                        <FontIcon FontSize="16" Glyph="&#xE708;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Search for bulbs"
                        Command="{x:Bind ViewModel.ScanCommand}"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTipService.ToolTip="Search for bulbs">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="More options"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTipService.ToolTip="More">
                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Click="NewButton_Click" Text="New button">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="NewGroup_Click" Text="New group">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE710;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="Settings_Click" Text="Settings">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="Exit_Click" Text="Exit TrayWiz">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8BB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar
                Grid.Row="1"
                Margin="16,0"
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />

            <!--  Empty state  -->
            <StackPanel
                Grid.Row="2"
                MaxWidth="260"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE82F;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="No bulbs found" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Make sure this PC is on the same network as your WiZ lights and that 'Allow local communication' is on in the WiZ app."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.ScanCommand}"
                    Content="Search again" />
            </StackPanel>

            <!--  Bulb tiles. Dropping a tile here (outside any group) takes it out of its group.  -->
            <ScrollViewer
                Grid.Row="2"
                Padding="12,8,12,12"
                AllowDrop="True"
                Background="Transparent"
                DragOver="Ungrouped_DragOver"
                Drop="Ungrouped_Drop">
                <!--  ItemsControl rather than ItemsRepeater: a handful of bulbs doesn't need virtualization, and never recycling containers means each bulb's controls stay bound to that bulb for life.  -->
                <StackPanel Width="384" HorizontalAlignment="Center">
                    <ItemsControl
                        ItemTemplateSelector="{StaticResource TileTemplateSelector}"
                        ItemsPanel="{StaticResource TilePanelTemplate}"
                        ItemsSource="{x:Bind ViewModel.Ungrouped}" />

                    <ItemsControl x:Name="GroupsList" ItemsSource="{x:Bind ViewModel.Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:BulbGroup">
                                <StackPanel
                                    Margin="0,4,0,8"
                                    AllowDrop="True"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    DragEnter="Group_DragEnter"
                                    DragLeave="Group_DragLeave"
                                    DragOver="Group_DragOver"
                                    Drop="Group_Drop">
                                    <Grid Padding="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            AutomationProperties.HeadingLevel="Level2"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.Name="{x:Bind local:MainPage.GroupPowerName(Name, x:True), Mode=OneWay}"
                                            Click="GroupOn_Click"
                                            Content="On"
                                            FontSize="12"
                                            Style="{StaticResource HeaderIconButtonStyle}"
                                            ToolTipService.ToolTip="Turn group on" />
                                        <Button
                                            Grid.Column="2"
                                            AutomationProperties.Name="{x:Bind local:MainPage.GroupPowerName(Name, x:False), Mode=OneWay}"
                                            Click="GroupOff_Click"
                                            Content="Off"
                                            FontSize="12"
                                            Style="{StaticResource HeaderIconButtonStyle}"
                                            ToolTipService.ToolTip="Turn group off" />
                                        <Button
                                            Grid.Column="3"
                                            AutomationProperties.Name="{x:Bind local:MainPage.GroupOptionsName(Name), Mode=OneWay}"
                                            Click="GroupOptions_Click"
                                            Style="{StaticResource HeaderIconButtonStyle}"
                                            ToolTipService.ToolTip="Group options">
                                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                                        </Button>
                                    </Grid>
                                    <Rectangle
                                        Height="1"
                                        Margin="4,0,4,4"
                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <ItemsControl
                                        ItemTemplateSelector="{StaticResource TileTemplateSelector}"
                                        ItemsPanel="{StaticResource TilePanelTemplate}"
                                        ItemsSource="{x:Bind Tiles}" />
                                    <TextBlock
                                        Margin="4,12,4,16"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Drag lights here"
                                        Visibility="{x:Bind EmptyVisibility, Mode=OneWay}" />

                                    <Rectangle
                                        Height="1"
                                        Margin="4,0"
                                        Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  A fresh BulbDetailView is placed here when a tile's chevron is clicked.  -->
        <ContentPresenter x:Name="DetailHost" Visibility="Collapsed">
            <ContentPresenter.ContentTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="40" FromVerticalOffset="0" />
                </TransitionCollection>
            </ContentPresenter.ContentTransitions>
        </ContentPresenter>
    </Grid>
</Page>
