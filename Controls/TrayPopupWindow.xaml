<?xml version="1.0" encoding="utf-8" ?>
<ex:WindowEx
    x:Class="TrayWiz.Controls.TrayPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="using:WinUIEx"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TrayWiz"
    mc:Ignorable="d">

    <Grid x:Name="PopupRoot" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <ContentPresenter x:Name="PageHost" />
    </Grid>
</ex:WindowEx>
