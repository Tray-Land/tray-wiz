<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TrayWiz.Controls.ActionEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="BackAccelerator_Invoked" />
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
    </UserControl.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header: back, title, step  -->
        <Grid Padding="8,12,16,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Padding="8"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ActionEditorBack"
                AutomationProperties.Name="Back"
                Background="Transparent"
                BorderThickness="0"
                Click="Back_Click"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleText"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    x:Name="StepText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="16,4,16,16">
            <Grid>
                <!--  Step 1: which lights  -->
                <StackPanel x:Name="TargetsPanel" Spacing="4">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Pick the groups and lights this button controls."
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="GroupsHeading"
                        Margin="0,8,0,0"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Groups" />
                    <StackPanel x:Name="GroupChecks" />
                    <TextBlock
                        x:Name="BulbsHeading"
                        Margin="0,8,0,0"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Lights" />
                    <StackPanel x:Name="BulbChecks" />
                    <TextBlock
                        x:Name="NoLightsText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="No lights yet. Search for bulbs first."
                        Visibility="Collapsed" />
                </StackPanel>

                <!--  Step 2: what it does  -->
                <StackPanel
                    x:Name="SettingsPanel"
                    Spacing="14"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="CapabilityText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />

                    <RadioButtons
                        x:Name="PowerChoice"
                        Header="Power"
                        SelectedIndex="0"
                        SelectionChanged="PowerChoice_SelectionChanged">
                        <x:String>Leave as is</x:String>
                        <x:String>Turn on</x:String>
                        <x:String>Turn off</x:String>
                    </RadioButtons>

                    <StackPanel x:Name="LightingPanel" Spacing="14">
                        <StackPanel Spacing="4">
                            <CheckBox
                                x:Name="BrightnessCheck"
                                Checked="Setting_Changed"
                                Content="Set brightness"
                                Unchecked="Setting_Changed" />
                            <Slider
                                x:Name="BrightnessSlider"
                                AutomationProperties.Name="Brightness"
                                IsEnabled="False"
                                Maximum="100"
                                Minimum="10"
                                StepFrequency="1"
                                Value="100" />
                        </StackPanel>

                        <ComboBox
                            x:Name="LookCombo"
                            HorizontalAlignment="Stretch"
                            Header="Light"
                            SelectionChanged="LookCombo_SelectionChanged" />

                        <Slider
                            x:Name="TemperatureSlider"
                            Header="White temperature (K)"
                            StepFrequency="50"
                            Visibility="Collapsed" />

                        <StackPanel
                            x:Name="ColorPanel"
                            Spacing="8"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="Color" />
                                <Ellipse
                                    x:Name="ColorPreview"
                                    Width="16"
                                    Height="16"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    StrokeThickness="1" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button AutomationProperties.Name="Red" Background="#FF3B30" Click="PresetColor_Click" Style="{StaticResource SwatchButtonStyle}" Tag="FF3B30" ToolTipService.ToolTip="Red" />
                                <Button AutomationProperties.Name="Orange" Background="#FF9500" Click="PresetColor_Click" Style="{StaticResource SwatchButtonStyle}" Tag="FF9500" ToolTipService.ToolTip="Orange" />
                                <Button AutomationProperties.Name="Yellow" Background="#FFCC00" Click="PresetColor_Click" Style="{StaticResource SwatchButtonStyle}" Tag="FFCC00" ToolTipService.ToolTip="Yellow" />
                                <Button AutomationProperties.Name="Green" Background="#34C759" Click="PresetColor_Click" Style="{StaticResource SwatchButtonStyle}" Tag="34C759" ToolTipService.ToolTip="Green" />
                                <Button AutomationProperties.Name="Cyan" Background="#32ADE6" Click="PresetColor_Click" Style="{StaticResource SwatchButtonStyle}" Tag="32ADE6" ToolTipService.ToolTip="Cyan" />
                                <Button AutomationProperties.Name="Blue" Background="#007AFF" Click="PresetColor_Click" Style="{StaticResource SwatchButtonStyle}" Tag="007AFF" ToolTipService.ToolTip="Blue" />
                                <Button AutomationProperties.Name="Purple" Background="#AF52DE" Click="PresetColor_Click" Style="{StaticResource SwatchButtonStyle}" Tag="AF52DE" ToolTipService.ToolTip="Purple" />
                                <Button
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    AutomationProperties.Name="Custom color"
                                    CornerRadius="14"
                                    ToolTipService.ToolTip="Custom color">
                                    <FontIcon FontSize="12" Glyph="&#xE790;" />
                                    <Button.Flyout>
                                        <Flyout Closed="ColorFlyout_Closed" Opening="ColorFlyout_Opening" ShouldConstrainToRootBounds="False">
                                            <ColorPicker
                                                x:Name="CustomColorPicker"
                                                ColorChanged="ColorPicker_ColorChanged"
                                                ColorSpectrumShape="Ring"
                                                IsAlphaEnabled="False"
                                                IsColorChannelTextInputVisible="False"
                                                IsColorPreviewVisible="False"
                                                IsHexInputVisible="False"
                                                IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <ComboBox
                            x:Name="SceneCombo"
                            HorizontalAlignment="Stretch"
                            Header="Scene"
                            SelectionChanged="Setting_Changed"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <!--  Step 3: name and icon  -->
                <StackPanel
                    x:Name="NamePanel"
                    Spacing="14"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="NameBox"
                        Header="Name"
                        MaxLength="40"
                        PlaceholderText="Movie night"
                        TextChanged="NameBox_TextChanged" />

                    <GridView
                        x:Name="IconGrid"
                        Header="Icon"
                        SelectionMode="Single">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <FontIcon
                                    Width="40"
                                    Height="40"
                                    FontSize="20"
                                    Glyph="{x:Bind}" />
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Footer  -->
        <Grid Grid.Row="2" Padding="16,8,16,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="Cancel_Click" Content="Cancel" />
            <Button
                x:Name="NextButton"
                Grid.Column="1"
                Click="Next_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
